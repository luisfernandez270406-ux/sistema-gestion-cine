<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Reservaciones</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
    <div class="logo">🎬 CineManager</div>

    <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/peliculas">Películas</a>
        <a href="/reservaciones">Reservaciones</a>
    </div>
</nav>

<div class="container">

    <h1>Reservaciones</h1>

    <a href="/reservaciones/nueva" class="btn">
        + Nueva Reservación
    </a>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Asientos</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            <% reservaciones.forEach(r => { %>
                <tr>
                    <td><%= r.id %></td>
                    <td><%= r.cliente %></td>
                    <td><%= r.asientos %></td>
                    <td>
                        <a href="/reservaciones/editar/<%= r.id %>" class="btn-editar">Editar</a>
                        <a href="/reservaciones/eliminar/<%= r.id %>" class="btn-eliminar">Eliminar</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</div>

</body>
</html>