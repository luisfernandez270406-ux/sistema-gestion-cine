<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reservaciones</title>
</head>
<body>
    <h1>Reservaciones</h1>
    <ul>
        <% reservaciones.forEach(reservacion => { %>
            <li>
                <strong>Cliente:</strong> <%= reservacion.nombreCliente %><br>
                <strong>Cantidad de boletos:</strong> <%= reservacion.cantidad %><br>
                <strong>Nombre de la Pelicula:</strong> <%= reservacion.nombrePelicula %>
            </li>
        <% }) %>
    </ul>

    <h2>Agregar Reservación</h2>
    <form action="/reservaciones" method="POST">
        <div>
            <label for="nombreCliente">Nombre del Cliente:</label>
            <input type="text" id="nombreCliente" name="nombreCliente" required>
        </div>
        <div>
            <label for="cantidad">Cantidad de Boletos:</label>
            <input type="number" id="cantidad" name="cantidad" min="1" required>
        </div>
        <div>
            <label for="funcionId">ID de la Función:</label>
            <input type="text" id="funcionId" name="funcionId" required>
        </div>
        <button type="submit">Agregar Reservación</button>
    </form>

    <button onclick="window.location.href='/peliculas'">Volver a la Lista de Películas</button>
</body>
</html>