<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Reservaciones</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
    <div class="logo">
         CineManager
    </div>

    <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/peliculas">Películas</a>
        <a href="/reservaciones">Reservas</a>
        <a href="/funciones">Funciones</a>
        <% if (usuario && (usuario.rol === 'admin' || usuario.rol === 'empleado')) { %>
            <a href="/productos">Productos</a>
            <a href="/ventas">Ventas</a>
        <% } %>
    </div>
    <% if(usuario){ %>

        <div class="usuario-info">
            <span class="rol <%= usuario.rol %>">
                 <%= usuario.rol %>
            </span>

            <span class="usuario-nombre">
                 <%= usuario.usuario %>
            </span>

            <a href="/usuarios/logout" class="logout">
                Cerrar sesión
            </a>

        </div>

    <% } else { %>

    <div class="usuario-info">

        <a href="/usuarios/login" class="btn-login">
            Iniciar sesión
        </a>

    </div>

<% } %>
</nav>

<div class="container">

    <div class="header-page">
        <h1>Reservaciones</h1>
        <% if (usuario) { %>
            <a href="/reservaciones/nueva" class="btn">Nueva Reserva</a>
        <% } %>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Asientos</th>
                <th>Película</th>
                <th>Sala</th>
                <th>Horario</th>
                <th>Precio</th>
                <% if (usuario && (usuario.rol === 'admin' || usuario.rol === 'empleado')) { %>
                    <th>Acciones</th>
                <% } %>
            </tr>
        </thead>

        <tbody>
            <% reservaciones.forEach(r => { %>
                <tr>
                    <td><%= r.id %></td>
                    <td><%= r.nombre_cliente %></td>
                    <td><%= r.cantidad_asientos %></td>
                    <td><%= r.titulo %></td>
                    <td><%= r.sala %></td>
                    <td><%= r.horario %></td>
                    <td><%= r.precio %></td>

                    <% if (usuario && (usuario.rol === 'admin' || usuario.rol === 'empleado')) { %>
                        <td class="acciones">
                            <a href="/reservaciones/editar/<%= r.id %>" class="btn-editar">
                                Editar
                            </a>
                            <form action="/reservaciones/eliminar/<%= r.id %>?_method=DELETE" method="POST" style="display:inline;">
                                <button type="submit" class="btn-eliminar">
                                    Eliminar
                                </button>
                            </form>
                        </td>
                    <% } %>
                </tr>
            <% }) %>
        </tbody>
    </table>

</div>

</body>
</html>
