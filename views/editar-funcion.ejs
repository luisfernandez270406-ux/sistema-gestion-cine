<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Editar Función</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <nav>
        <div class="logo">
         CineManager
        </div>

        <div class="nav-links">
            <a href="/">Inicio</a>
            <a href="/peliculas">Películas</a>
            <a href="/reservaciones">Reservas</a>
            <a href="/funciones">Funciones</a>
        </div>
        <% if(usuario){ %>

        <div class="usuario-info">
            <span class="rol <%= usuario.rol %>">
                 <%= usuario.rol %>
            </span>

            <span class="usuario-nombre">
                 <%= usuario.usuario %>
            </span>

            <a href="/usuarios/logout" class="logout">
                Cerrar sesión
            </a>

        </div>

        
        

    <% } else { %>

    <div class="usuario-info">

        <a href="/usuarios/login" class="btn-login">
            Iniciar sesión
        </a>

    </div>

<% } %>
    </nav>

    <div class="container">

        <h1>Editar Función</h1>

    <form action="/funciones/editar/<%= funcion.id %>?_method=PUT"method="POST">
        <label>Película</label>
        <select name="id_pelicula">

        <% peliculas.forEach(p=>{ %>

        <option
            value="<%= p.id %>"
            <%= p.id==funcion.id_pelicula ? "selected":"" %>>
            <%= p.titulo %>
        </option>

        <% }) %>

    </select>

    <label>Sala</label>

    <select name="id_sala">

        <% salas.forEach(s=>{ %>

        <option
        value="<%= s.id %>"
        <%= s.id==funcion.id_sala ? "selected":"" %>>

        <%= s.nombre %>

        </option>

        <% }) %>

        </select>

        <label>Horario</label>

        <input type="datetime-local"name="horario"value="<%= funcion.horario %>">
        <label>Precio</label>
        <input type="number"step="0.01"name="precio"value="<%= funcion.precio %>">

    <button class="btn">
    Guardar cambios

    </button>

    </form>

    </div>

</body>

</html>