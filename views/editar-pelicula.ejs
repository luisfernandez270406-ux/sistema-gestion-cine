<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Película</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
    <div class="logo">
         CineManager
    </div>

    <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/peliculas">Películas</a>
        <a href="/reservaciones">Reservas</a>
    </div>
    <% if(usuario){ %>

        <div class="usuario-info">
            <span class="rol <%= usuario.rol %>">
                 <%= usuario.rol %>
            </span>

            <span class="usuario-nombre">
                 <%= usuario.usuario %>
            </span>

            <a href="/usuarios/logout" class="logout">
                Cerrar sesión
            </a>

        </div>

        
        

    <% } else { %>

    <div class="usuario-info">

        <a href="/usuarios/login" class="btn-login">
            Iniciar sesión
        </a>

    </div>

<% } %>
</nav>

<div class="form-container">

    <h1>Editar Película</h1>

    <form action="/peliculas/editar/<%= pelicula.id %>?_method=PUT" method="POST">

        <input type="text" name="titulo" value="<%= pelicula.titulo %>" required>
        <input type="text" name="genero" value="<%= pelicula.genero %>" required>
        <input type="text" name="duracion" value="<%= pelicula.duracion %>">
        <input type="text" name="director" value="<%= pelicula.director %>">
        <input type="number" name="anio" value="<%= pelicula.anio %>">
        <textarea name="sinopsis"><%= pelicula.sinopsis %></textarea>

        <button type="submit" class="btn">Guardar</button>

    </form>

</div>

</body>
</html>