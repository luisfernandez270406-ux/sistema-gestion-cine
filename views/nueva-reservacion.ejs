<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Nueva Reserva</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
    <div class="logo">
         CineManager
    </div>

    <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/peliculas">Películas</a>
        <a href="/reservaciones">Reservas</a>
    </div>
    <% if(usuario){ %>

        <div class="usuario-info">
            <span class="rol <%= usuario.rol %>">
                 <%= usuario.rol %>
            </span>

            <span class="usuario-nombre">
                 <%= usuario.usuario %>
            </span>

            <a href="/usuarios/logout" class="logout">
                Cerrar sesión
            </a>

        </div>

        
        

    <% } else { %>

    <div class="usuario-info">

        <a href="/usuarios/login" class="btn-login">
            Iniciar sesión
        </a>

    </div>

<% } %>
</nav>

<div class="container">

    <h1>Nueva Reservación</h1>

   <form action="/reservaciones" method="POST">

    <% if (usuario && usuario.rol === "cliente") { %>

    <input
        type="text"
        value="<%= usuario.usuario %>"
        disabled
    >

<% } else { %>

    <input
        name="nombre_cliente"
        placeholder="Nombre del cliente"
        required
    >

<% } %>

    <input name="cantidad_asientos" placeholder="Cantidad de asientos" required>

    <input name="id_funcion" placeholder="ID de la función" required>

    <button type="submit">Crear reservación</button>

</form>

</div>

</body>
</html>
</html>