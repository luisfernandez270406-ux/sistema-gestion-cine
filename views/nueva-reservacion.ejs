<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Nueva Reserva</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
    <div class="logo">
         CineManager
    </div>

    <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/peliculas">Películas</a>
        <a href="/reservaciones">Reservas</a>
        <a href="/funciones">Funciones</a>
        <% if (usuario && (usuario.rol === 'admin' || usuario.rol === 'empleado')) { %>
            <a href="/productos">Productos</a>
            <a href="/ventas">Ventas</a>
        <% } %>
    </div>
    <% if(usuario){ %>

        <div class="usuario-info">
            <span class="rol <%= usuario.rol %>">
                 <%= usuario.rol %>
            </span>

            <span class="usuario-nombre">
                 <%= usuario.usuario %>
            </span>

            <a href="/usuarios/logout" class="logout">
                Cerrar sesión
            </a>

        </div>

    <% } else { %>

    <div class="usuario-info">

        <a href="/usuarios/login" class="btn-login">
            Iniciar sesión
        </a>

    </div>

<% } %>
</nav>

<div class="container">

    <h1>Nueva Reservación</h1>

    <form action="/reservaciones" method="POST">

    <label>Cliente</label>

    <% if (usuario && usuario.rol !== 'cliente') { %>
        <select name="id_usuario" required>
            <option value="">Seleccione un cliente</option>
            <% clientes.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.nombre %> (<%= c.usuario %>)</option>
            <% }) %>
        </select>
    <% } else { %>
        <select disabled>
            <option selected><%= usuario.nombre %> (<%= usuario.usuario %>)</option>
        </select>
        <input type="hidden" name="id_usuario" value="<%= usuario.id %>">
    <% } %>

    <label>Cantidad de asientos</label>
    <input name="cantidad_asientos" type="number" min="1" placeholder="Cantidad de asientos" required>

    <label>Función</label>
    <select name="id_funcion" required>
        <option value="">Seleccione una función</option>
        <% funciones.forEach(funcion => { %>
            <option value="<%= funcion.id %>">
                <%= funcion.titulo %>
                -
                <%= funcion.sala %>
                -
                <%= funcion.horario %>
                -
                $<%= funcion.precio %>
            </option>
        <% }) %>
    </select>
    <br>
    <br>
    <button type="submit" class="btn">Crear reservación</button>

</form>

</div>

</body>
</html>
