<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Nueva Reserva</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
    <div class="logo">CineManager</div>

    <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/reservaciones">Reservaciones</a>
    </div>
</nav>

<div class="container">

    <h1>Nueva Reservación</h1>

   <form action="/reservaciones" method="POST">

    <input name="nombre_cliente" placeholder="Nombre del cliente" required>

    <input name="cantidad_asientos" placeholder="Cantidad de asientos" required>

    <input name="id_funcion" placeholder="ID de la función" required>

    <button type="submit">Crear reservación</button>

</form>

</div>

</body>
</html>
</html>