<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Nueva Reservación</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
    <div class="logo">🎬 CineManager</div>

    <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/peliculas">Películas</a>
        <a href="/reservaciones">Reservaciones</a>
    </div>
</nav>

<div class="form-container">

    <h1>Nueva Reservación</h1>

    <form action="/reservaciones/crear" method="POST">

        <div class="form-group">
            <label>Cliente</label>
            <input type="text" name="cliente" required>
        </div>

        <div class="form-group">
            <label>Asientos</label>
            <input type="number" name="asientos" required>
        </div>

        <div class="form-group">
            <label>Fecha</label>
            <input type="date" name="fecha">
        </div>

        <button type="submit" class="btn">
            Guardar
        </button>

    </form>

</div>

</body>
</html>