<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Nueva Venta</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
        <div class="logo">
         CineManager
        </div>

        <div class="nav-links">
            <a href="/">Inicio</a>
            <a href="/peliculas">Películas</a>
            <a href="/reservaciones">Reservas</a>
            <a href="/funciones">Funciones</a>
        </div>
        <% if(usuario){ %>

        <div class="usuario-info">
            <span class="rol <%= usuario.rol %>">
                 <%= usuario.rol %>
            </span>

            <span class="usuario-nombre">
                 <%= usuario.usuario %>
            </span>

            <a href="/usuarios/logout" class="logout">
                Cerrar sesión
            </a>

        </div>

        
        

    <% } else { %>

    <div class="usuario-info">

        <a href="/usuarios/login" class="btn-login">
            Iniciar sesión
        </a>

    </div>

<% } %>
    </nav>

<div class="container">

    <h1>Nueva Venta</h1>

    <form action="/ventas" method="POST">

        <label>Cliente</label>
        <select name="id_usuario" required>
            <option value="">Selecciona un cliente</option>
            <% clientes.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.nombre %> (<%= c.usuario %>)</option>
            <% }) %>
        </select>

        <label>Producto</label>
        <select name="id_producto" required>
            <option value="">Selecciona un producto</option>
            <% productos.forEach(p => { %>
                <option value="<%= p.id %>">
                    <%= p.nombre %> - $<%= p.precio %> (stock: <%= p.stock %>)
                </option>
            <% }) %>
        </select>

        <label>Cantidad</label>
        <input type="number" name="cantidad" min="1" required>

        <button type="submit" class="btn">Registrar Venta</button>

    </form>

</div>

</body>
</html>
