<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Películas</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
    <div class="logo">
         CineManager
    </div>

    <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/peliculas">Películas</a>
        <a href="/reservaciones">Reservas</a>
    </div>
    <% if(usuario){ %>

        <div class="usuario-info">
            <span class="rol <%= usuario.rol %>">
                 <%= usuario.rol %>
            </span>

            <span class="usuario-nombre">
                 <%= usuario.usuario %>
            </span>

            <a href="/usuarios/logout" class="logout">
                Cerrar sesión
            </a>

        </div>

        
        

    <% } else { %>

    <div class="usuario-info">

        <a href="/usuarios/login" class="btn-login">
            Iniciar sesión
        </a>

    </div>

<% } %>
</nav>

<div class="container">

    <div class="header-page">

    <h1>Películas</h1>

    <a href="/peliculas/nueva" class="btn">
        + Nueva Película
    </a>

</div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Género</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            <% peliculas.forEach(p => { %>
                <tr>
                    <td><%= p.id %></td>
                    <td><%= p.titulo %></td>
                    <td><%= p.genero %></td>
                    <td class="acciones">
                        <a href="/peliculas/editar/<%= p.id %>" class="btn-editar">Editar</a>
                        <form action="/peliculas/eliminar/<%= p.id %>?_method=DELETE" method="POST" style="display:inline;">
                            <button type="submit" class="btn-eliminar">
                                Eliminar
                            </button>
                        </form>
                     </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</div>

</body>
</html>