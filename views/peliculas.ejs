<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Películas</title>
</head>
<body>
    <h1>Lista de Películas</h1>
    <ul>
        <% peliculas.forEach(pelicula => { %>
            <li><strong><%= pelicula.titulo %></strong> - Director: <%= pelicula.director %>, Año: <%= pelicula.anio %>, Duración: <%= pelicula.duracion %> min, sinopsis: <%= pelicula.sinopsis %></li>
        <% }) %>
    </ul>

    <button onclick="window.location.href='/peliculas/nueva'">Agregar Nueva Película</button>

    
    
</body>
</html>