<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Productos</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
    <div class="logo">
         CineManager
    </div>

    <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/peliculas">Películas</a>
        <a href="/reservaciones">Reservas</a>
        <a href="/funciones">Funciones</a>
        <% if (usuario && (usuario.rol === 'admin' || usuario.rol === 'empleado')) { %>
            <a href="/productos">Productos</a>
            <a href="/ventas">Ventas</a>
        <% } %>
    </div>
    <% if(usuario){ %>

        <div class="usuario-info">
            <span class="rol <%= usuario.rol %>">
                 <%= usuario.rol %>
            </span>

            <span class="usuario-nombre">
                 <%= usuario.usuario %>
            </span>

            <a href="/usuarios/logout" class="logout">
                Cerrar sesión
            </a>

        </div>

    <% } else { %>

    <div class="usuario-info">

        <a href="/usuarios/login" class="btn-login">
            Iniciar sesión
        </a>

    </div>

<% } %>
</nav>

<div class="container">

    <div class="header-page">
        <h1>Productos</h1>
        <% if (usuario && (usuario.rol === 'admin')) { %>
        <a href="/productos/nuevo" class="btn">+ Nuevo Producto</a>
        <% } %>
        
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Activo</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            <% productos.forEach(p => { %>
                <tr>
                    <td><%= p.id %></td>
                    <td><%= p.nombre %></td>
                    <td>$<%= p.precio %></td>
                    <td><%= p.stock %></td>
                    <td><%= p.activo ? 'Sí' : 'No' %></td>
                    <td class="acciones">
                        <a href="/productos/editar/<%= p.id %>" class="btn-editar">Editar</a>
                        <form action="/productos/eliminar/<%= p.id %>?_method=DELETE" method="POST" style="display:inline;">
                            <button type="submit" class="btn-eliminar">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</div>

</body>
</html>
