<!DOCTYPE html>
<html>
<head>
    <title>Sistema de Cine</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
    <div class="logo">
         CineManager
    </div>

    <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/peliculas">Películas</a>
        <a href="/reservaciones">Reservas</a>
        <a href="/funciones">Funciones</a>
        <% if (usuario && (usuario.rol === 'admin' || usuario.rol === 'empleado')) { %>
            <a href="/productos">Productos</a>
            <a href="/ventas">Ventas</a>
        <% } %>
    </div>
    <% if(usuario){ %>

        <div class="usuario-info">
            <span class="rol <%= usuario.rol %>">
                 <%= usuario.rol %>
            </span>

            <span class="usuario-nombre">
                 <%= usuario.usuario %>
            </span>

            <a href="/usuarios/logout" class="logout">
                Cerrar sesión
            </a>

        </div>

    <% } else { %>

    <div class="usuario-info">

        <a href="/usuarios/login" class="btn-login">
            Iniciar sesión
        </a>

    </div>

<% } %>
</nav>

<section class="hero">

    <div class="overlay">

        <h1>Bienvenido a CineManager</h1>

        <p>
            Sistema de administración para la gestión
            de películas y reservas.
        </p>

        <div class="botones">

            <a href="/peliculas" class="btn">
                Ver Películas
            </a>

            <% if (usuario) { %>
                <a href="/reservaciones" class="btn-secundario">
                    Ver Reservas
                </a>
            <% } else { %>
                <a href="/usuarios/login" class="btn-secundario">
                    Iniciar Sesión
                </a>
            <% } %>

        </div>

    </div>

</section>
<section class="modulos">

    <h2>Módulos del Sistema</h2>

    <div class="cards">

        <a href="/peliculas" class="card card-link">
            <h3>Películas</h3>
            <p>
                <% if (usuario && (usuario.rol === 'admin' || usuario.rol === 'empleado')) { %>
                    Crea, edita, consulta y elimina películas registradas.
                <% } else { %>
                    Consulta la cartelera disponible.
                <% } %>
            </p>
        </a>

        <a href="/funciones" class="card card-link">
            <h3>Funciones</h3>
            <p>
                <% if (usuario && (usuario.rol === 'admin' || usuario.rol === 'empleado')) { %>
                    Programa horarios y gestiona la cartelera.
                <% } else { %>
                    Consulta horarios y funciones disponibles.
                <% } %>
            </p>
        </a>

        <% if (usuario) { %>
            <a href="/reservaciones" class="card card-link">
                <h3>Reservaciones</h3>
                <p>
                    <% if (usuario.rol === 'cliente') { %>
                        Consulta tus propias reservaciones.
                    <% } else { %>
                        Administra las reservaciones de los clientes.
                    <% } %>
                </p>
            </a>
        <% } %>

        <% if (usuario && (usuario.rol === 'admin' || usuario.rol === 'empleado')) { %>
            <a href="/productos" class="card card-link">
                <h3>Productos</h3>
                <p>Gestiona dulcería y productos disponibles para la venta.</p>
            </a>

            <a href="/ventas" class="card card-link">
                <h3>Ventas</h3>
                <p>Registra ventas de productos y consulta el historial.</p>
            </a>
        <% } %>

    </div>

</section>
<footer>
    CineManager © 2026
</footer>

</body>
</html>
