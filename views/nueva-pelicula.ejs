<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agregar Película</title>
</head>
<body>
    <h1>Agregar Nueva Película</h1>
    <form action="/peliculas" method="POST">
        <label for="titulo">Título:</label>
        <input type="text" id="titulo" name="titulo" required><br>

        <label for="director">Director:</label>
        <input type="text" id="director" name="director" required><br>

        <label for="anio">Año:</label>
        <input type="number" id="anio" name="anio"><br>

        <label for="genero">Género:</label>
        <input type="text" id="genero" name="genero"><br>

        <label for="duracion">Duración (min):</label>
        <input type="number" id="duracion" name="duracion"><br>

        <label for="sinopsis">Sinopsis:</label><br>
        <textarea id="sinopsis" name="sinopsis"></textarea><br>

        <button type="submit">Agregar Película</button>
    </form>

    <button onclick="window.location.href='/peliculas'">Volver a la Lista de Películas</button>
    <button onclick="window.location.href='/'">Volver al Inicio</button>
    
</body>
</html>