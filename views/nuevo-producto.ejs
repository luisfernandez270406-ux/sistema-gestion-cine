<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Nuevo Producto</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<nav>
    <div class="logo">
         CineManager
    </div>

    <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/peliculas">Películas</a>
        <a href="/reservaciones">Reservas</a>
        <a href="/funciones">Funciones</a>
        <% if (usuario && (usuario.rol === 'admin' || usuario.rol === 'empleado')) { %>
            <a href="/productos">Productos</a>
            <a href="/ventas">Ventas</a>
        <% } %>
    </div>
    <% if(usuario){ %>

        <div class="usuario-info">
            <span class="rol <%= usuario.rol %>">
                 <%= usuario.rol %>
            </span>

            <span class="usuario-nombre">
                 <%= usuario.usuario %>
            </span>

            <a href="/usuarios/logout" class="logout">
                Cerrar sesión
            </a>

        </div>

    <% } else { %>

    <div class="usuario-info">

        <a href="/usuarios/login" class="btn-login">
            Iniciar sesión
        </a>

    </div>

<% } %>
</nav>

<div class="container">

    <h1>Nuevo Producto</h1>

    <form action="/productos" method="POST">

        <input name="nombre" placeholder="Nombre" required>
        <textarea name="descripcion" placeholder="Descripción"></textarea>
        <input name="precio" type="number" step="0.01" placeholder="Precio" required>
        <input name="stock" type="number" placeholder="Stock inicial" required>

        <div style="margin: 10px 0;">
            <label>
                <input type="radio" name="activo" value="true" checked>
                Activo
            </label>
            <label style="margin-left: 15px;">
                <input type="radio" name="activo" value="false">
                Inactivo
            </label>
        </div>

        <button type="submit" class="btn">Guardar</button>

    </form>

</div>

</body>
</html>
