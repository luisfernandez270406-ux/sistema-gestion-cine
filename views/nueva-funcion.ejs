<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Nueva Función</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
        <div class="logo">
         CineManager
        </div>

        <div class="nav-links">
            <a href="/">Inicio</a>
            <a href="/peliculas">Películas</a>
            <a href="/reservaciones">Reservas</a>
            <a href="/funciones">Funciones</a>
        </div>
        <% if(usuario){ %>

        <div class="usuario-info">
            <span class="rol <%= usuario.rol %>">
                 <%= usuario.rol %>
            </span>

            <span class="usuario-nombre">
                 <%= usuario.usuario %>
            </span>

            <a href="/usuarios/logout" class="logout">
                Cerrar sesión
            </a>

        </div>

        
        

    <% } else { %>

    <div class="usuario-info">

        <a href="/usuarios/login" class="btn-login">
            Iniciar sesión
        </a>

    </div>

<% } %>
    </nav>

<div class="container">

    <h1>Nueva Función</h1>

    <form action="/funciones" method="POST">

        <label>Película</label>

        <select name="id_pelicula" required>

            <% peliculas.forEach(pelicula => { %>

                <option value="<%= pelicula.id %>">

                    <%= pelicula.titulo %>

                </option>

            <% }) %>

        </select>

        <br><br>

        <label>Sala</label>

        <select name="id_sala" required>

            <% salas.forEach(sala => { %>

                <option value="<%= sala.id %>">

                    <%= sala.nombre %>

                </option>

            <% }) %>

        </select>

        <br><br>

        <label>Horario</label>

        <input
            type="datetime-local"
            name="horario"
            required
        >

        <br><br>

        <label>Precio</label>

        <input
            type="number"
            name="precio"
            step="0.01"
            required
        >

        <br><br>

        <button class="btn" type="submit">
            Crear Función
        </button>

    </form>

</div>

</body>
</html>