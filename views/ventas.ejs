<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ventas</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
        <div class="logo">
         CineManager
        </div>

        <div class="nav-links">
            <a href="/">Inicio</a>
            <a href="/peliculas">Películas</a>
            <a href="/reservaciones">Reservas</a>
            <a href="/funciones">Funciones</a>
        </div>
        <% if(usuario){ %>

        <div class="usuario-info">
            <span class="rol <%= usuario.rol %>">
                 <%= usuario.rol %>
            </span>

            <span class="usuario-nombre">
                 <%= usuario.usuario %>
            </span>

            <a href="/usuarios/logout" class="logout">
                Cerrar sesión
            </a>

        </div>

        
        

    <% } else { %>

    <div class="usuario-info">

        <a href="/usuarios/login" class="btn-login">
            Iniciar sesión
        </a>

    </div>

<% } %>
    </nav>

<div class="container">

    <div class="header-page">
        <h1>Ventas</h1>
        <a href="/ventas/nuevo" class="btn">+ Nueva Venta</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Producto</th>
                <th>Cliente</th>
                <th>Cantidad</th>
                <th>Total</th>
                <th>Fecha</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            <% ventas.forEach(v => { %>
                <tr>
                    <td><%= v.id %></td>
                    <td><%= v.producto %></td>
                    <td><%= v.usuario %></td>
                    <td><%= v.cantidad %></td>
                    <td>$<%= v.total %></td>
                    <td><%= v.fecha %></td>
                    <td class="acciones">
                        <a href="/ventas/editar/<%= v.id %>" class="btn-editar">Editar</a>
                        <form action="/ventas/eliminar/<%= v.id %>?_method=DELETE" method="POST" style="display:inline;">
                            <button type="submit" class="btn-eliminar">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</div>

</body>
</html>
