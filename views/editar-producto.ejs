<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Producto</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
    <div class="logo">
         CineManager
    </div>

    <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/peliculas">Películas</a>
        <a href="/reservaciones">Reservas</a>
        <a href="/funciones">Funciones</a>
        <% if (usuario && (usuario.rol === 'admin' || usuario.rol === 'empleado')) { %>
            <a href="/productos">Productos</a>
            <a href="/ventas">Ventas</a>
        <% } %>
    </div>
    <% if(usuario){ %>

        <div class="usuario-info">
            <span class="rol <%= usuario.rol %>">
                 <%= usuario.rol %>
            </span>

            <span class="usuario-nombre">
                 <%= usuario.usuario %>
            </span>

            <a href="/usuarios/logout" class="logout">
                Cerrar sesión
            </a>

        </div>

    <% } else { %>

    <div class="usuario-info">

        <a href="/usuarios/login" class="btn-login">
            Iniciar sesión
        </a>

    </div>

<% } %>
</nav>

<div class="form-container">

    <h1>Editar Producto</h1>

    <form action="/productos/editar/<%= producto.id %>?_method=PUT" method="POST">

        <input type="text" name="nombre" value="<%= producto.nombre %>" required>
        <textarea name="descripcion"><%= producto.descripcion %></textarea>
        <input type="number" step="0.01" name="precio" value="<%= producto.precio %>" required>
        <input type="number" name="stock" value="<%= producto.stock %>" required>

        <div style="margin: 10px 0;">
            <label>
                <input type="radio" name="activo" value="true" <%= producto.activo ? 'checked' : '' %>>
                Activo
            </label>
            <label style="margin-left: 15px;">
                <input type="radio" name="activo" value="false" <%= !producto.activo ? 'checked' : '' %>>
                Inactivo
            </label>
        </div>

        <button type="submit" class="btn">Guardar</button>

    </form>

</div>

</body>
</html>