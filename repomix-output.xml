    PeliculasModel.listar()
        .then(peliculas => {
            res.json(peliculas);})
        .catch(error => {
            // Si algo falla, capturamos el error
            console.error('Error al listar películas:', error);
            res.status(500).json({ error: 'Error interno al obtener las películas' });
        });
}


