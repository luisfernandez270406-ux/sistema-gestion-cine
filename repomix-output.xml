<file path="utils/token.js">
import jwt from 'jsonwebtoken';
 
export function generarToken(usuario) {
    return jwt.sign(
        {
            id: usuario.id,
            nombre: usuario.nombre,
            usuario: usuario.usuario,
            rol: usuario.rol,
        },
        process.env.JWT_SECRET,
        { expiresIn: '2h' }
    );
}
